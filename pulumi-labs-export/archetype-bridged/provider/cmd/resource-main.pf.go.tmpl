// Command pulumi-resource-__PROVIDER__ is the provider resource server binary.
// The Pulumi CLI starts it to serve CRUD operations. It embeds the schema
// that `make schema` writes next to this file, so `pulumi package get-schema`
// on the binary returns the schema the SDKs were generated from.
package main

import (
	"context"
	_ "embed"

	pf "github.com/pulumi/pulumi-terraform-bridge/v3/pkg/pf/tfbridge"

	__GO_PKG__ "github.com/pulumi-labs/pulumi-__PROVIDER__/provider"
)

//go:embed schema.json
var pulumiSchema []byte

func main() {
	pf.Main(context.Background(), "__PROVIDER__", __GO_PKG__.Provider(), pf.ProviderMetadata{PackageSchema: pulumiSchema})
}
