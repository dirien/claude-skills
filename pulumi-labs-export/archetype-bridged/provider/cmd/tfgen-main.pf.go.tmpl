// Command pulumi-tfgen-__PROVIDER__ generates the Pulumi schema and bridge
// metadata by introspecting the bridged Terraform provider. `make schema`
// runs it; the SDKs are then generated from the schema it writes.
package main

import (
	pftfgen "github.com/pulumi/pulumi-terraform-bridge/v3/pkg/pf/tfgen"

	__GO_PKG__ "github.com/pulumi-labs/pulumi-__PROVIDER__/provider"
)

func main() {
	pftfgen.Main("__PROVIDER__", __GO_PKG__.Provider())
}
